VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: fixed public version manifest URL.
# Example: https://download.example.com/lianleme/version.json
VITE_VERSION_MANIFEST_URL=

# Optional legacy multi-source fallback, comma-separated.
VITE_VERSION_MANIFEST_URLS=

# The anon key is public by design; database access must still be protected by RLS.
# Never put service_role key, database password, OAuth AppSecret,
# Android keystore, token, cookie, or private key in this file.
